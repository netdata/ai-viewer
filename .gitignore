# Build artifacts
/bin/
/dist/
/ai-viewer
/ai-viewer-ingest
/ai-viewer-serve

# Go
*.test
*.out
coverage.txt
coverage.html

# Frontend
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
*.tsbuildinfo

# go:embed frontend bundle (generated by scripts/build.sh; never committed).
# Keep only the .gitkeep sentinel so `//go:embed all:frontend_dist` compiles
# on a clean checkout and `git status` stays clean after a release build.
/cmd/ai-viewer-serve/frontend_dist/*
!/cmd/ai-viewer-serve/frontend_dist/.gitkeep

# SQLite runtime data
*.db
*.db-shm
*.db-wal

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Private per-user overrides
AGENTS.local.md
CLAUDE.local.md
CRUSH.local.md

# Local environment
.env
.env.local

# Local fixture caches (real session data; never commit)
/testdata-local/

# Playwright MCP local cache (regenerated per run; never commit)
/.playwright-mcp/
