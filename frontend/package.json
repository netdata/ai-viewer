{
  "name": "ai-viewer-frontend",
  "version": "0.1.0",
  "description": "Read-only real-time explorer for AI coding-agent session snapshots",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test --project=chromium",
    "e2e:a11y": "playwright test --project=chromium tests/a11y.spec.ts tests/viz-a11y.spec.ts tests/stats-a11y.spec.ts",
    "e2e:quarantine": "playwright test --project=quarantine --pass-with-no-tests",
    "check:bundle-size": "node scripts/check-bundle-size.js",
    "check:bundle-size:selftest": "bash scripts/check-bundle-size.test.sh",
    "check:coverage-config": "node scripts/check-coverage-config.mjs",
    "check:coverage-config:selftest": "bash scripts/check-coverage-config.test.sh",
    "check:coverage-thresholds:selftest": "bash scripts/check-coverage-thresholds.test.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "5.100.14",
    "d3-array": "3.2.4",
    "d3-force": "3.0.0",
    "d3-hierarchy": "3.1.2",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.15.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/d3-array": "3.2.2",
    "@types/d3-force": "3.0.10",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/jest-axe": "3.5.9",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "jest-axe": "10.0.0",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vite": "^8.0.16",
    "vitest": "4.1.7"
  }
}
