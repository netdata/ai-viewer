{
  "name": "ai-viewer-frontend",
  "version": "0.1.0",
  "description": "Read-only real-time explorer for AI coding-agent session snapshots",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test --project=chromium",
    "e2e:a11y": "playwright test --project=chromium tests/a11y.spec.ts tests/viz-a11y.spec.ts tests/stats-a11y.spec.ts",
    "e2e:quarantine": "playwright test --project=quarantine --pass-with-no-tests",
    "check:bundle-size": "node scripts/check-bundle-size.js",
    "check:bundle-size:selftest": "bash scripts/check-bundle-size.test.sh",
    "check:coverage-config": "node scripts/check-coverage-config.mjs",
    "check:coverage-config:selftest": "bash scripts/check-coverage-config.test.sh",
    "check:coverage-thresholds:selftest": "bash scripts/check-coverage-thresholds.test.sh"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "5.101.4",
    "cmdk": "^1.1.1",
    "d3-array": "3.2.4",
    "d3-force": "3.0.0",
    "d3-hierarchy": "3.1.2",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "js-yaml": "4.2.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.29.0",
    "motion": "^12.40.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^9.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "7.18.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.4",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@playwright/test": "1.62.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/d3-array": "3.2.2",
    "@types/d3-force": "3.0.10",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/jest-axe": "3.5.9",
    "@types/node": "25.9.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jest-axe": "10.0.0",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "tailwind-merge": "^3.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "^8.2.1",
    "vitest": "4.1.10"
  }
}
